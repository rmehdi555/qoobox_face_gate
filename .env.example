# PostgreSQL
POSTGRES_USER=facegate
POSTGRES_PASSWORD=facegate
POSTGRES_DB=facegate
DATABASE_URL=postgresql+psycopg://facegate:facegate@postgres:5432/facegate

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# Face recognition (CPU only — do not install onnxruntime-gpu)
FACE_RECOGNITION_THRESHOLD=0.5
FACE_RECOGNITION_MODEL=buffalo_s
RECOGNITION_INTERVAL_MS=500
ONNX_EXECUTION_PROVIDERS=CPUExecutionProvider
CUDA_VISIBLE_DEVICES=-1

# Optional CPU thread cap
OMP_NUM_THREADS=4

# Images via ArvanCloud (Docker Hub and AWS ECR are often unreachable)
POSTGRES_IMAGE=docker.arvancloud.ir/library/postgres:16-alpine
PYTHON_IMAGE=docker.arvancloud.ir/library/python:3.12-slim-bookworm
NODE_IMAGE=docker.arvancloud.ir/library/node:22-alpine
NGINX_IMAGE=docker.arvancloud.ir/library/nginx:1.27-alpine
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
PIP_EXTRA_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com

# Uploads
MAX_UPLOAD_SIZE_MB=10
MAX_AUDIO_UPLOAD_SIZE_MB=25
STORAGE_PATH=/app/storage/faces
INSIGHTFACE_HOME=/app/storage/models

# Speech to text (CPU Whisper)
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=/app/storage/whisper

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
